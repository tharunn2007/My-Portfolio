# ---------------------------------------------------------------------------
# macOS Portfolio — environment template
# Copy to .env.local and fill in what you need. Everything is OPTIONAL:
# the site degrades gracefully (apps show placeholders) without any keys.
# NEVER commit real keys — only .env.example (this file) goes in git.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO/sitemap/OG absolute URLs).
# Local dev works without it; set it on deploy, e.g. https://your-site.com
SITE_URL=

# Groq — powers the AI assistant chat + speech (Siri-style features).
# Without it the assistant falls back to canned config answers.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Jamendo — powers the Music app streaming.
# Without it the Music app shows the library UI but can't stream.
# Get a client id: https://devportal.jamendo.com/  (PASTE THE REAL ID IN .env.local ONLY)
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# TMDB — powers the Apple TV app catalog.
# Without it the Apple TV app shows an empty catalog.
# Get a key: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# Video call names (FaceTime/Call apps) — optional display-name overrides.
# Defaults come from src/constants/profile.js ("Tharunn", "Contact One", "Contact Two").
NEXT_PUBLIC_VIDEOCALL_OWNER=
NEXT_PUBLIC_VIDEOCALL_CONTACT_1=
NEXT_PUBLIC_VIDEOCALL_CONTACT_2=
